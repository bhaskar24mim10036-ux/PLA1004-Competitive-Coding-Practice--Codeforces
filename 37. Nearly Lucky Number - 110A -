##Nearly Lucky Number - 110A

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String n = sc.next();

        int count = 0;

        for (int i = 0; i < n.length(); i++) {
            char c = n.charAt(i);

            if (c == '4' || c == '7') {
                count++;
            }
        }

        if (count == 4 || count == 7 ||
            isLucky(count)) {
            System.out.println("YES");
        } else {
            System.out.println("NO");
        }
    }

    static boolean isLucky(int n) {
        while (n > 0) {
            int digit = n % 10;

            if (digit != 4 && digit != 7) {
                return false;
            }

            n /= 10;
        }

        return true;
    }
}
