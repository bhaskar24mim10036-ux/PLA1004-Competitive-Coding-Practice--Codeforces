## New Year and Hurry - 750A

import java.util.Scanner;
 
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
 
        int n = sc.nextInt();
        int k = sc.nextInt();
 
        int availableTime = 240 - k;
        int totalTime = 0;
        int count = 0;
 
        for (int i = 1; i <= n; i++) {
            totalTime += 5 * i;
 
            if (totalTime <= availableTime) {
                count++;
            } else {
                break;
            }
        }
 
        System.out.println(count);
    }
}

