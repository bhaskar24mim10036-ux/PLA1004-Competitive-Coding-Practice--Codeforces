###Turing Tape - 132A


import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String text = sc.nextLine();

        int previous = 0;

        for (int i = 0; i < text.length(); i++) {
            int current = text.charAt(i);

            int reversed = reverseBits(previous);

            int answer = (reversed - current + 256) % 256;

            System.out.println(answer);

            previous = current;
        }

        sc.close();
    }

    static int reverseBits(int x) {
        int result = 0;

        for (int i = 0; i < 8; i++) {
            result = result * 2 + (x % 2);
            x /= 2;
        }

        return result;
    }
}