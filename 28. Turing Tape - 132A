##Turing Tape - 132A

import java.util.*;

public class Main {

    // Reverse the 8 bits of a number
    static int reverseBits(int x) {
        int result = 0;

        for (int i = 0; i < 8; i++) {
            result = (result << 1) | (x & 1);
            x >>= 1;
        }

        return result;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String text = sc.nextLine();

        int previous = 0;

        for (int i = 0; i < text.length(); i++) {

            int current = text.charAt(i);

            // Reverse bits of previous and current characters
            int prevReversed = reverseBits(previous);
            int currentReversed = reverseBits(current);

            // Find the original array element
            int answer = (prevReversed - currentReversed + 256) % 256;

            System.out.println(answer);

            previous = current;
        }

        sc.close();
    }
}